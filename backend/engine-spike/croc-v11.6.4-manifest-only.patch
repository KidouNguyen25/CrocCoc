 func (c *Client) processSenderInfo(senderInfo SenderInfo) (done bool, err error) {
+	if c.manifestOnly != nil {
+		ctx := c.clientContext()
+		if err := ctx.Err(); err != nil {
+			return true, err
+		}
+		if err := c.manifestOnly(ctx, senderInfo); err != nil {
+			return true, err
+		}
+		if err := ctx.Err(); err != nil {
+			return true, err
+		}
+		return true, ErrManifestOnly
+	}
 	if c.lifecycleSnapshot().FileInfoTransferred {
 		return true, errors.New("file metadata was already finalized")
 	}
diff --git a/src/croc/croccoc_manifest_only.go b/src/croc/croccoc_manifest_only.go
new file mode 100644
--- /dev/null
+++ b/src/croc/croccoc_manifest_only.go
@@ -0,0 +1,21 @@
+package croc
+
+import (
+	"context"
+	"errors"
+)
+
+// ErrManifestOnly means metadata was delivered and the transfer stopped.
+// It is intentionally not a successful file transfer.
+var ErrManifestOnly = errors.New("metadata-only receive stopped before payload")
+
+// ReceiveManifest runs a single metadata-only receive attempt with a
+// dedicated client. It does not permit requesting or storing payload.
+func (c *Client) ReceiveManifest(consume func(context.Context, SenderInfo) error) error {
+	if c == nil || c.Options.IsSender || consume == nil || c.manifestOnly != nil {
+		return errors.New("invalid metadata-only receive client")
+	}
+	c.manifestOnly = consume
+	defer func() { c.manifestOnly = nil }()
+	return c.Receive()
+}
