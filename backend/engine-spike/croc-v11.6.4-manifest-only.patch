+func TestCrocCocManifestOnlyHonorsCancellationAndRejection(t *testing.T) {
+	rejected := errors.New("local metadata rejection")
+	c := &Client{manifestOnly: func(context.Context, SenderInfo) error { return rejected }}
+	if done, err := c.processSenderInfo(SenderInfo{}); !done || !errors.Is(err, rejected) {
+		t.Fatalf("rejection: done=%v err=%v", done, err)
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c.stop = newStop(ctx)
+	c.manifestOnly = func(context.Context, SenderInfo) error {
+		cancel()
+		return nil
+	}
+	if done, err := c.processSenderInfo(SenderInfo{}); !done || !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation in callback: done=%v err=%v", done, err)
+	}
+	c.manifestOnly = func(context.Context, SenderInfo) error {
+		t.Fatal("cancelled receive invoked callback")
+		return nil
+	}
+	if done, err := c.processSenderInfo(SenderInfo{}); !done || !errors.Is(err, context.Canceled) {
+		t.Fatalf("pre-cancelled: done=%v err=%v", done, err)
+	}
+}
