+func TestCrocCocManifestOnlyLoopback(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 12*time.Second)
+	defer cancel()
+	relay := startTestRelayWithContext(t, ctx, 4)
+	source := filepath.Join(t.TempDir(), "fixture.txt")
+	if err := os.WriteFile(source, []byte("test"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	files, folders, count, err := GetFilesInfo([]string{source}, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dest := t.TempDir()
+	t.Chdir(dest)
+	receiveOptions := Options{
+		SharedSecret:  "point-frost-metadata-fixture",
+		RelayAddress:  relay.address,
+		RelayPassword: "pass123",
+		DisableLocal:  true,
+		Curve:         "siec",
+		Quiet:         true,
+	}
+	sendOptions := receiveOptions
+	sendOptions.IsSender = true
+	sendOptions.RelayPorts = append([]string(nil), relay.allPorts...)
+	sendOptions.Transport = TransportRelay
+	sender, err := NewCtx(ctx, sendOptions)
+	if err != nil {
+		t.Fatal(err)
+	}
+	receiver, err := NewCtx(ctx, receiveOptions)
+	if err != nil {
+		t.Fatal(err)
+	}
+	senderDone := make(chan error, 1)
+	go func() { senderDone <- sender.Send(files, folders, count) }()
+	calls := 0
+	receiveErr := receiver.ReceiveManifest(func(_ context.Context, info SenderInfo) error {
+		calls++
+		if len(info.FilesToTransfer) != 1 || info.FilesToTransfer[0].Name != "fixture.txt" ||
+			info.FilesToTransfer[0].Size != 4 || info.FilesToTransfer[0].FolderSource != "" {
+			return errors.New("unexpected loopback metadata")
+		}
+		items, err := os.ReadDir(dest)
+		if err != nil || len(items) != 0 {
+			return errors.New("destination changed before metadata callback")
+		}
+		return nil
+	})
+	cancel()
+	select {
+	case sendErr := <-senderDone:
+		if sendErr == nil || sender.lifecycleSnapshot().RecipientRequested {
+			t.Fatal("sender was allowed to enter the payload path")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("sender did not terminate")
+	}
+	if !errors.Is(receiveErr, ErrManifestOnly) || calls != 1 {
+		t.Fatalf("loopback callback calls=%d err=%v", calls, receiveErr)
+	}
+	items, err := os.ReadDir(dest)
+	if err != nil || len(items) != 0 {
+		t.Fatalf("receiver path changed after stopping: %d items, err=%v", len(items), err)
+	}
+}
