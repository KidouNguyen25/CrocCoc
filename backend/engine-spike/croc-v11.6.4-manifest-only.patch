+func TestCrocCocManifestOnlyStopsBeforePayload(t *testing.T) {
+	for _, chunked := range []bool{false, true} {
+		mode := "legacy"
+		if chunked {
+			mode = "chunked"
+		}
+		t.Run(mode, func(t *testing.T) {
+			dir := t.TempDir()
+			t.Chdir(dir)
+			c := manifestTestClient()
+			c.peerChunkedFileInfo = chunked
+			calls := 0
+			c.manifestOnly = func(ctx context.Context, info SenderInfo) error {
+				calls++
+				if ctx.Err() != nil || len(info.FilesToTransfer) != 1 ||
+					info.FilesToTransfer[0].Name != "fixture.txt" || info.FilesToTransfer[0].Size != 4 ||
+					len(info.EmptyFoldersToTransfer) != 1 || info.EmptyFoldersToTransfer[0].FolderRemote != "empty" {
+					t.Fatal("did not receive complete metadata")
+				}
+				return nil
+			}
+			info := SenderInfo{
+				FilesToTransfer:        []FileInfo{{FolderRemote: ".", Name: "fixture.txt", Size: 4}},
+				EmptyFoldersToTransfer: []FileInfo{{FolderRemote: "empty"}},
+				TotalNumberFolders:     1,
+				HashAlgorithm:          defaultHashAlgorithm,
+			}
+			var err error
+			var done bool
+			if chunked {
+				limits := fileInfoManifestLimits{maxBatchJSONSize: 180, maxEntries: 10, maxManifestJSONSize: 10_000}
+				err = emitChunkedSenderInfo(info, limits, func(m message.Message) error {
+					m = encryptedManifestRoundTrip(t, manifestTestKey, m)
+					switch m.Type {
+					case message.TypeFileInfoStart:
+						return c.processMessageFileInfoStartWithLimits(m, limits)
+					case message.TypeFileInfoBatch:
+						if calls != 0 {
+							t.Fatal("partial metadata reached the callback")
+						}
+						return c.processMessageFileInfoBatch(m)
+					case message.TypeFileInfoEnd:
+						var endErr error
+						done, endErr = c.processMessageFileInfoEnd(m)
+						return endErr
+					default:
+						t.Fatalf("unexpected frame type %q", m.Type)
+						return nil
+					}
+				})
+			} else {
+				data, marshalErr := json.Marshal(info)
+				if marshalErr != nil {
+					t.Fatal(marshalErr)
+				}
+				frame := encryptedManifestRoundTrip(t, manifestTestKey, message.Message{Type: message.TypeFileInfo, Bytes: data})
+				done, err = c.processMessageFileInfo(frame)
+			}
+			if !done || !errors.Is(err, ErrManifestOnly) || calls != 1 {
+				t.Fatalf("done=%v err=%v callback calls=%d", done, err, calls)
+			}
+			state := c.lifecycleSnapshot()
+			if state.FileInfoTransferred || state.RecipientRequested || state.Successful || c.receiveRoot != nil {
+				t.Fatal("metadata-only receive entered the write or request path")
+			}
+			items, err := os.ReadDir(dir)
+			if err != nil || len(items) != 0 {
+				t.Fatalf("receiver directory modified: %d items, err=%v", len(items), err)
+			}
+		})
+	}
+}
